#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${GIGBUDDY_PYTHON:-$ROOT/.venv/bin/python}"

if [[ ! -x "$PYTHON_BIN" ]]; then
    PYTHON_BIN="${PYTHON_BIN_FALLBACK:-python3}"
fi

case "${1:-}" in
    tone|chain|preset|-h|--help|--version)
        # CLI 子命令与帮助/版本
        exec "$PYTHON_BIN" "$ROOT/src/library.py" "$@"
        ;;
    *)
        # 无参数或 TUI 选项（--no-engine 等）：启动 TUI
        # （cd 到仓库根保证 `-m tui` 可导入）
        cd "$ROOT"
        exec "$PYTHON_BIN" -m tui "$@"
        ;;
esac
